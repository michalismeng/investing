@page
@model IndexModel
@{
    ViewData["Title"] = "Valuations";
}

<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#companyModal">
    Add Company
</button>

<div class="d-flex flex-column justify-content-between gap-4">

    <h1 class="text-center">Your Valuations</h1>

    <div class="container">
    <table class="table w-75 mx-auto">
        <thead>
            <tr>
                <td class="text-start">Company</td>
                <td class="text-center">Valuation</td>
                <td class="text-end">Actions</td>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model.Companies)
            {
                var latestValuation = c.Valuations.OrderByDescending(v => v.Date).FirstOrDefault();
                <tr>
                    <td class="text-start">@c.Name</td>
                    <td class="text-center">
                        @if(latestValuation != null)
                        {
                            <div class="d-flex flex-row gap-4 justify-content-center">
                                <div class="d-flex flex-row gap-2">
                                    <i class="bi bi-calendar"></i> @latestValuation.Date.ToString("MMM d, yyyy")
                                </div>
                                <div class="vr"></div>
                                <div class="d-flex flex-row gap-2"><i class="bi bi-newspaper"></i> @latestValuation.Report</div>
                                <div class="vr"></div>
                                <div class="d-flex flex-row gap-2">@latestValuation.IntrinsicValue.ToString("C2")</div>
                            </div>
                        }
                        else
                        {
                            <div>No valuations for this company yet</div>
                        }
                    </td>
                    <td class="text-end"><a class="btn btn-primary btn-sm" asp-page="Valuation" asp-route-companyId="@c.Id"><i class="bi bi-plus-circle-fill me-1"></i> Valuation</a></td>
                </tr>
            }
        </tbody>
    </table></div>
</div>


<!-- Modal -->
<div class="modal fade" id="companyModal" tabindex="-1" aria-labelledby="companyModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="companyModalLabel">Add a new Company</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="AddCompany">
                <div class="modal-body">
                    <div class="input-group mb-3">
                        <span class="input-group-text bg-white">Company Name</span>
                        <input type="text" class="form-control" name="company" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Add</button>
                </div>
            </form>
        </div>
    </div>
</div>