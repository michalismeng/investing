@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="d-flex flex-column justify-content-between gap-4">

    <h1 class="text-center">Dividend Discount Model</h1>

    <div class="d-flex justify-content-between">

        <div class="card">
            <div class="card-header">
                <div class="text-center fw-bold">Base Assumptions</div>
            </div>
            <div class="card-body">
                <form>
                    <div class="mb-3">
                        <label for="exampleFormControlInput1" class="form-label">Email address</label>
                        <input type="email" class="form-control" id="exampleFormControlInput1"
                            placeholder="name@example.com">
                    </div>
                    <div class="mb-3">
                        <label for="exampleFormControlInput1" class="form-label">Email address</label>
                        <input type="email" class="form-control" id="exampleFormControlInput1"
                            placeholder="name@example.com">
                    </div>
                    <div class="mb-3">
                        <label for="exampleFormControlInput1" class="form-label">Email address</label>
                        <input type="email" class="form-control" id="exampleFormControlInput1"
                            placeholder="name@example.com">
                    </div>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <div class="text-center fw-bold">Growth Assumptions</div>
            </div>
            <div class="card-body">
                <form>
                    <div class="mb-3">
                        <label for="exampleFormControlInput1" class="form-label">Email address</label>
                        <input type="email" class="form-control" id="exampleFormControlInput1"
                            placeholder="name@example.com">
                    </div>
                    <div class="mb-3">
                        <label for="exampleFormControlInput1" class="form-label">Email address</label>
                        <input type="email" class="form-control" id="exampleFormControlInput1"
                            placeholder="name@example.com">
                    </div>
                    <div class="mb-3">
                        <label for="exampleFormControlInput1" class="form-label">Email address</label>
                        <input type="email" class="form-control" id="exampleFormControlInput1"
                            placeholder="name@example.com">
                    </div>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <div class="text-center fw-bold">Stable Assumptions</div>
            </div>
            <div class="card-body">
                <form>
                    <div class="mb-3">
                        <label for="exampleFormControlInput1" class="form-label">Email address</label>
                        <input type="email" class="form-control" id="exampleFormControlInput1"
                            placeholder="name@example.com">
                    </div>
                    <div class="mb-3">
                        <label for="exampleFormControlInput1" class="form-label">Email address</label>
                        <input type="email" class="form-control" id="exampleFormControlInput1"
                            placeholder="name@example.com">
                    </div>
                    <div class="mb-3">
                        <label for="exampleFormControlInput1" class="form-label">Email address</label>
                        <input type="email" class="form-control" id="exampleFormControlInput1"
                            placeholder="name@example.com">
                    </div>
                </form>
            </div>
        </div>

    </div>

    <div class="d-flex justify-content-center w-100">

        <table class="table table-sm text-center">
            <thead>
                <tr>
                    <th class="col-1"></th>
                    @{
                        var ordinals = Model.Valuation.Data.Select(d => d.Ordinal).Distinct().Order();
                        var maxOrdinal = ordinals.Max();
                        foreach(var o in ordinals)
                        {
                            if (o == maxOrdinal) {
                                <th class="col-1 border-start">Terminal</th>
                            } else {
                                <th class="col-1">@(Model.Valuation.Date.AddYears(o).Year)</th>
                            }
                        }
                    }
                </tr>
            </thead>
            <tbody class="text-nowrap">
                @{
                    var descriptors = Model.Valuation.Data.Select(d => d.Characteristic)
                                                          .Distinct()
                                                          .Order()
                                                          .Select(d => ValuationDescriptors.DDMValuationDescriptors.SingleOrDefault(dd => dd.Characteristic == d));
                }
                @foreach (var desc in descriptors)
                {
                    <tr>
                        <th class="text-start">@desc.Characteristic</th>
                        @{
                            var ordinalMax = Model.Valuation.Data.Where(d => d.Characteristic == desc.Characteristic).Max(d => d.Ordinal);
                        }
                        @foreach (var data in Model.Valuation.Data.Where(d => d.Characteristic == desc.Characteristic).OrderBy(d => d.Ordinal))
                        {
                            <td
                                class="cell-hover @(data.Ordinal == ordinalMax ? "border-start" : "")">
                                @if(desc.DisplayFormat == DisplayFormat.Currency)
                                {
                                    @data.Value.ToString("C2")
                                }
                                else if(desc.DisplayFormat == DisplayFormat.Percent)
                                {
                                    @data.Value.ToString("P2")
                                }
                                else
                                {
                                    @data.Value
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-center w-100">
        <div class="card">
            <div class="card-header">
                <div class="text-center fw-bold">Valuation Result</div>
            </div>
            <div class="card-body mx-4">
                <table class="table table-sm">
                    <tbody>
                        <tr>
                            <th>Fair Value</th>
                            <td>10</td>
                        </tr>
                        <tr>
                            <th>Value in place</th>
                            <td>20</td>
                        </tr>
                        <tr>
                            <th>Value of Growth</th>
                            <td>20</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div>

</div>