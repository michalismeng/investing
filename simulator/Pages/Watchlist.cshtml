@page
@using simulator.Extensions
@model WatchlistModel
@{
    ViewData["Title"] = $"Watchlist for {Model.Date:yyyy-MM-dd}";
}

<div class="container-fluid px-4 py-2">
    <h1 class="text-center">@ViewData["Title"]</h1>

    <div class="my-2">

    <table id="datatable" class="display table table-sm table-hover table-bordered border border-2">
        <thead>
          <tr>
            <th scope="col">Ticker</th>
            <th scope="col">Name</th>
            <th scope="col">Sector</th>
            <th scope="col">Percentile</th>
            <th scope="col">Relative Strength</th>
            <th scope="col">Close</th>
            <th scope="col" class="text-center">Quarterly Earnings</th>
            <th scope="col" class="text-center">Annual Earnings</th>
            <th scope="col">Actions</th>
          </tr>
        </thead>
        <tbody>
          @foreach(var tickerModel in Model.Tickers)
          {
            var ticker = tickerModel.Ticker;
            var data = tickerModel.PriceData;
            <tr>
              <th scope="row">@ticker.Ticker</th>
              <td scope="row">@ticker.Name</td>
              <td scope="row">@ticker.Sector</td>
              <td scope="row">@data.Percentile</td>
              <td scope="row">@Math.Round(data.RelativeStrength!.Value, 2)</td>
              <td scope="row">@Math.Round(data.Close, 2)</td>
              <td scope="row">
                <table class="table table-sm small text-center">
                  <thead>
                    <tr>
                      <th class="border-0 text-center">Date</th>
                      <th class="border-0 text-center">EPS</th>
                      <th class="border-0 text-center">YoY</th>
                      <th class="border-0 text-center">YoY Smooth</th>
                    </tr>
                  </thead>
                  <tbody class="lh-1">
                    @foreach(var e in tickerModel.Earnings)
                    {
                      <tr>
                        <td class="text-center"><div>@e.entry.FiscalDateEnding.ToString("yyyy-MM-dd")</div></td>
                        <td class="text-center"><div>$@e.entry.ReportedEPS.Round()</div></td>
                        <td><div>@(e.change > 0 ? e.change.Value.ToString("P2") : $"({(-e.change.Value).ToString("P2")})")</div></td>
                        <td>
                          @if(e.smooth != null) {
                            <div>@(e.smooth > 0 ? e.smooth.Value.ToString("P2") : $"({(-e.smooth.Value).ToString("P2")})")</div>
                          }
                        </td>
                      </tr>
                    }
                  </tbody>
                </table>
              </td>
              <td scope="row">
                <table class="table table-sm small text-center">
                  <thead>
                    <tr>
                      <th class="border-0 text-center">Date</th>
                      <th class="border-0 text-center">EPS</th>
                      <th class="border-0 text-center">YoY</th>
                      <th class="border-0 text-center">YoY Smooth</th>
                    </tr>
                  </thead>
                  <tbody class="lh-1">
                    @foreach(var e in tickerModel.AnnualEarnings)
                    {
                      <tr>
                        <td class="text-center"><div>@e.entry.FiscalDateEnding.ToString("yyyy-MM-dd")</div></td>
                        <td class="text-center"><div>$@e.entry.ReportedEPS.Round()</div></td>
                        <td><div>@(e.change > 0 ? e.change.Value.ToString("P2") : $"({(-e.change.Value).ToString("P2")})")</div></td>
                        <td>
                          @if(e.smooth != null) {
                            <div>@(e.smooth > 0 ? e.smooth.Value.ToString("P2") : $"({(-e.smooth.Value).ToString("P2")})")</div>
                          }
                        </td>
                      </tr>
                    }
                  </tbody>
                </table>
              </td>
              <td scope="row"><a class="btn btn-outline-primary" asp-page="Realtime" asp-route-ticker="@ticker.Ticker" asp-route-cutoff="@Model.Date.ToString("yyyy-MM-dd")">To chart</a></td>
            </tr>
          }
        </tbody>
    </table>
    </div>
</div>

@section Scripts {
    <partial name="_DataTableScript" model='(4, "desc")' />
}
