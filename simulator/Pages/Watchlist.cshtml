@page
@model WatchlistModel
@{
    ViewData["Title"] = "Generate Stage 2 Report";
}

<div class="px-4 py-2 d-flex flex-column gap-4">
    <h1 class="text-center">@ViewData["Title"]</h1>

    <div class="container">
    <div class="card">
      <div class="card-header text-center fw-bold">
        Filters
      </div>
      <form id="filters-form" class="d-flex flex-row p-2" style="height: fit-content;" hx-get="/Watchlist" hx-trigger="params" hx-target="#watchlist-table" hx-indicator="#spinner" hx-push-url="true">
        <div class="card-body w-75 d-flex flex-column gap-2">
          <div class="d-flex flex-row align-items-center">
            <label class="form-label" style="width: 30rem;">Select the date for the report:</label>
            <input asp-for="Filters.Date" type="date" class="form-control">
          </div>
          <div class="d-flex flex-row align-items-center">
            <label class="form-label" style="width: 30rem;">Minimum 50-Day average volume:</label>
            <input asp-for="Filters.Volume" step="1" type="number" class="form-control">
          </div>
          <div class="d-flex flex-row align-items-center">
            <label class="form-label" style="width: 30rem;">Minimum earnings growth YoY:</label>
            <input asp-for="Filters.EarningsGrowth" step="0.01" type="number" class="form-control">
          </div>
          <div class="d-flex flex-row align-items-center">
            <label class="form-label" style="width: 30rem;">Maximum number of shares:</label>
            <input asp-for="Filters.SharesOutstanding" step="1" type="number" class="form-control">
          </div>
          <div class="d-flex flex-row align-items-center">
            <label class="form-label" style="width: 30rem;">How many quarters to require this growth?</label>
            <input asp-for="Filters.EarningsGrowthQuarters" step="1" type="number" class="form-control">
          </div>
          <div class="d-flex flex-row align-items-center">
            <div style="width: 30rem;" class="lh-1 d-flex flex-column">
              <label class="form-label">How much drop over SPY to allow?</label>
            </div>
            <input asp-for="Filters.MaxDropOverSPY" step="0.01" type="number" class="form-control">
          </div>
        </div>
        <div class="d-flex flex-column gap-2">
          <button type="submit" class="btn btn-outline-dark h-100">Search</button>
          <a asp-page="Watchlist" class="btn btn-outline-dark h-100 d-flex flex-column justify-content-center">Clear</a>
        </div>
      </form>
    </div></div>

  <div id="spinner" class="my-indicator w-100 h-25 flex-column justify-content-center align-items-center gap-2">
    <div class="spinner-grow" role="status">
      <span class="visually-hidden">Loading...</span>
    </div>
    <p>Loading</p>
  </div>

  <div id="watchlist-table"></div>
</div>

@section Scripts {
    <partial name="_DataTableScript" />

    <script>
      $(document).ready(function() {
        let urlParams = new URLSearchParams(window.location.search);
        if(urlParams.size > 0) {
          htmx.trigger("#filters-form", "params")
        }
      });
      var dataTable = null;
      document.addEventListener('htmx:beforeRequest', function(evt) {
        if(dataTable) {
          dataTable.destroy()
          $("#watchlist-table").empty()
        }
      });
      document.addEventListener('htmx:afterRequest', function(evt) {
        dataTable = createDataTable('datatable');
      });
    </script>
}
