@page
@using System.Text.Json
@model RealtimeModel
@{
    ViewData["Title"] = "Home page";
}

<div class="container-fluid p-4 h-100">
    <div class="row h-100">
        <div class="col-lg-9 col-sm-12 h-100">
            <div id="chart-spy" class="w-100 h-25" style="position: relative;"></div>
            <div id="chart" class="w-100 h-75" style="position: relative;"></div>
        </div>
        <div class="col-lg-3 col-sm-12 ps-4 d-flex flex-column gap-4 h-75">
            <h1 class="text-center display-4 my-0">@Model.TickerInfo.Name </h1>

            <div x-data>
                <p class="text-center">Latest date information</p>
                <div class="d-flex flex-row justify-content-between gap-4">
                    <table class="table table-sm align-bottom">
                        <tr>
                            <th>Date</th>
                            <td x-text="$store.infoPanel.date.format('ddd MMM DD, YYYY')"></td>
                        </tr>
                        <tr>
                            <th>Price</th>
                            <td x-text="Math.round($store.infoPanel.price * 100) / 100"></td>
                        </tr>
                    </table>
                    
                    <div class="d-flex flex-column gap-4">
                        <button :title="$store.infoPanel.nextDate.format('dddd MMM DD, YYYY')" data-bs-toggle="tooltip" data-bs-placement="top" class="btn btn-outline-dark d-flex flex-row gap-2 align-items-center" onclick="advanceData()">Next</button>
                        <button class="btn btn-outline-dark" onclick="buyLatestDay()">Buy</button>
                    </div>
                </div>
            </div>
            <div x-data>
                <p class="text-center">Your entry points</p>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th style="width: 9rem">Date</th>
                            <th class="text-center">Price</th>
                            <th class="text-center">% Chg.</th>
                            <th class="text-center" style="width: 8rem">Stop-loss</th>
                            <th style="width: 2rem"></th>
                        </tr>
                    </thead>
                    <tbody> 
                        <template x-for="entry in $store.entryPoints.entries">
                            <tr :class="{ 'text-muted': entry.stopLossTriggered }">
                                <td><span x-text="entry.date.format('YYYY-MM-DD')"></span> (<span x-text="entry.holdingDays"></span>d)</td>
                                <td class="text-center" x-text="Math.round(entry.price * 100) / 100"></td>
                                <td class="text-center"><span x-text="Math.round(entry.pctChange * 100) / 100"></span>%</td>
                                <td class="text-center" style="width: 8rem" x-data="{ stopLoss: entry.stopLoss }">
                                    <span class="clickable" x-show="! entry.stopLossEditing" x-on:click="entry.stopLossEditing = true" x-text="Math.round(entry.stopLoss * 100) / 100 + ' (' + Math.round((entry.stopLoss / entry.price - 1) * 100) + '%)'" data-bs-toggle="tooltip" :title="'Stop loss set @@ ' + stopLoss"></span>
                                    <i x-show="entry.stopLossTriggered" data-bs-toggle="tooltip" data-bs-placement="top" :title="'Stop loss triggered @@ ' + Math.round(entry.triggerPrice * 100) / 100" class="fa-solid fa-bolt"></i>
                                    <input x-show="entry.stopLossEditing" x-model="stopLoss" @@keyup.enter="entry.stopLoss = parseStopLoss(stopLoss, entry.price) ; entry.stopLossEditing = false" x-on:blur="entry.stopLoss = parseStopLoss(stopLoss, entry.price) ; entry.stopLossEditing = false" class="form-control form-control-sm w-75 text-center mx-auto">
                                </td>
                                <td><a x-show="! entry.stopLossTriggered" style="color: black" href="javascript:void(0);" x-on:click="$store.entryPoints.remove(entry.date)"><i class="fa-solid fa-xmark"></i></button></td>
                            </tr>
                        </template>
                    </tbody>
                </table>
            </div>
            <div class="mt-auto d-flex flex-column gap-4">
                <div class="btn-group">
                    <button type="button" class="btn btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                      Toggle indicators
                    </button>
                    <ul class="dropdown-menu w-100 text-center">
                        <li><button class="dropdown-item btn btn-outline-primary" onclick="toggleIndicator('stock20Day')">Toggle 20 Day MA</button></li>
                        <li><button class="dropdown-item btn btn-outline-primary" onclick="toggleIndicator('stock10Week')">Toggle 10 MA</button></li>
                        <li><button class="dropdown-item btn btn-outline-primary" onclick="toggleIndicator('stock30Week')">Toggle 30 MA</button></li>
                        <li><button class="dropdown-item btn btn-outline-primary" onclick="toggleIndicator('stock40Week')">Toggle 40 MA</button></li>
                        <li><button class="dropdown-item btn btn-outline-primary" onclick="toggleIndicator('stock52High')">Toggle 52 Week High</button></li>
                        <li><button class="dropdown-item btn btn-outline-primary" onclick="toggleIndicator('stock52Low')">Toggle 52 Week Low</button></li>
                        <li><button class="dropdown-item btn btn-outline-primary" onclick="toggleIndicator('stockStrength')">Toggle Strength</button></li>
                        <li><button class="dropdown-item btn btn-outline-primary" onclick="toggleStage2()">Toggle Stage 2</button></li>
                    </ul>
                </div>
                <div class="btn-group">
                    <button type="button" class="btn btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                      Change price scale
                    </button>
                    <ul class="dropdown-menu w-100 text-center">
                      <li><a class="dropdown-item" onclick="setPriceMode('linear')" href="#">Linear</a></li>
                      <li><a class="dropdown-item" onclick="setPriceMode('logarithmic')" href="#">Logarithmic</a></li>
                      <li><a class="dropdown-item" onclick="setPriceMode('percentage')" href="#">Percentage</a></li>
                    </ul>
                </div>
                <div class="btn-group">
                    <button type="button" class="btn btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                      Change time granularity
                    </button>
                    <ul class="dropdown-menu w-100 text-center">
                      <li><a class="dropdown-item" href="#">Daily</a></li>
                      <li><a class="dropdown-item" href="#">Weekly</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<div x-data='{label: "", fiscalDate: "0001-01-01", time: "0001-01-01", eps: 0, estimate: 0, surprise: 0}' class="d-none dropdown earnings-box" id="time-marker-template">
    <span href="#" role="button" class='nostyle earnings-box' :class="{ 'earnings-up': surprise >= 0, 'earnings-down': surprise < 0 }"
                data-bs-offset="-100,20" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" id="+template+" style="position: absolute; left: +template+; bottom: 0; z-index: 10">
      <span x-text="label"></span>
    </span>
    <div style="width: 250px" class="dropdown-menu earnings-dropdown noselect rounded" :class="{ 'border-success': surprise >= 0, 'border-danger': surprise < 0 }" aria-labelledby="+template+">
        <div class='p-2' style='height: 300px'>
            <div class="h5 fw-bold">Earnings & Revenue</div>
            <table class="w-100 table table-sm table-borderless fw-normal small lh-1">
                <tbody>
                    <tr>
                        <td>Date</td>
                        <td><span x-text="moment(time).format('ddd D MMM \'YY')"></span></td>
                    </tr>
                    <tr>
                        <td>Period Ending</td>
                        <td><span x-text="moment(fiscalDate).format('ddd D MMM \'YY')"></span></td>
                    </tr>
                    <tr><td></td></tr>
                    <tr><td></td></tr>
                    <tr><td class="text-muted small">EARNINGS</td></tr>
                    <tr>
                        <td>Reported</td>
                        <td><span x-text="eps"></span></td>
                    </tr>
                    <tr>
                        <td>Estimate</td>
                        <td><span x-text="estimate"></span></td>
                    </tr>
                    <tr class="fw-bold" :class="{ 'text-success': surprise >= 0, 'text-danger': surprise < 0 }" >
                        <td>Surprise</td>
                        <td><span x-text="round(surprise * 100) + '%'"></span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>


@section PerScripts
{
    <script src="~/js/tradingViewCharts.js" asp-append-version="true"></script>
}

@section Scripts
{
    <script>
        @* Initialize Alpine store *@
        document.addEventListener('alpine:init', () => {
            Alpine.store('infoPanel', {
                date: moment(),
                nextDate: moment().clone().add(1, 'days'),
                price: 10,

                update(date, price) {
                    this.date = date
                    this.nextDate = date.clone().add(1, 'days')
                    this.price = price
                },
            })
            let date = moment(slast(stockPrices).time)
            let price = slast(stockPrices).close
            Alpine.store("infoPanel").update(date, price)

            Alpine.store('entryPoints', {
                entries: [],

                addIfNew(date, price) {
                    if(this.entries.find(e => e.date.format("YYYY-MM-DD") == date.format("YYYY-MM-DD")))
                        return;
                    this.entries.push({ date: date, price: price, holdingDays: 0, pctChange: 0, stopLoss: round(0.95 * price), stopLossEditing: false, stopLossTriggered: false, triggerPrice: null })
                },

                update(latestDate, latestPrice, latestLow, latestHigh, latestOpen) {
                    // Update stop-loss - check whether it triggers
                    for(let e of this.entries) {
                        if(e.stopLossTriggered == false && e.stopLoss >= latestLow) {
                            // The stop-loss triggers, hence the position is closed by selling at the stop-loss
                            e.stopLossTriggered = true
                            let sellPrice;
                            if (latestOpen < e.stopLoss) sellPrice = latestOpen;
                            else if (latestHigh < e.stopLoss) sellPrice = latestHigh;
                            else sellPrice = e.stopLoss;
                            e.triggerPrice = sellPrice;
                            e.pctChange = (sellPrice / e.price - 1) * 100
                            e.holdingDays = latestDate.diff(e.date, 'days')
                        }
                    }
                    for(let e of this.entries) {
                        if(e.stopLossTriggered == false) {
                            e.pctChange = (latestPrice / e.price - 1) * 100
                            e.holdingDays = latestDate.diff(e.date, 'days')
                        }
                    }
                },

                remove(date) {
                    let index = this.entries.findIndex(e => e.date.format("YYYY-MM-DD") == date.format("YYYY-MM-DD"));
                    if (index !== -1) {
                      this.entries.splice(index, 1);
                    }
                }
            })
        })

        const earningsData = [
        @foreach(var e in Model.Earnings)
        {
            @: { time: '@e.ReportedDate.ToString("yyyy-MM-dd")', label: 'E', fiscalDate: '@e.FiscalDateEnding.ToString("yyyy-MM-dd")', eps: @e.ReportedEPS, estimate: @e.EstimatedEPS, surprise: @e.SurprisePercentage },
        }
        ];

        @* Variables *@
        let currentDate = moment("@Model.CutoffDate.ToString("yyyy-MM-dd")");

        function drawTimeScaleMarkers(chart) {
            const container = document.getElementById(TIME_SCALE_MARKERS_ELEMENT_ID);
            container.innerHTML = ''; // Clear previous markers

            i = 0;
            earningsData.forEach(marker => {
                const coordinate = chart.timeScale().timeToCoordinate(marker.time);
                if (coordinate) {
                    if(coordinate + 90 >= container.getBoundingClientRect().left && coordinate + 95 + 90 <= container.getBoundingClientRect().right) {
                        let element = $("#time-marker-template").clone().removeAttr('id').removeClass("d-none").attr('x-data', JSON.stringify(marker))
                        element.find("span").attr('id', `dropdownMenuButton-${i}`).css('left', `${coordinate - 15}px`)
                        element.find("div").attr('aria-labelledby', `dropdownMenuButton-${i}`)
                        container.appendChild(element.get(0))
                    }
                }
                i++;
            });
        }

        @* Initialize charts *@
        const [chart, chartSPY, stockPrices, spyPrices] = setUpCharts('chart', 'chart-spy', "@Model.TickerInfo", "@Model.TickerInfoSPY", drawTimeScaleMarkers)

        @* Initialize data *@
        spyPrices.setData([
            @foreach(var record in Model.SPY)
            {
                @: { open: @record.Open, high: @record.High, low: @record.Low, close: @record.Close, time: "@record.Date.ToString("yyyy-MM-dd")" },
            }
        ]);
        stockPrices.setData([
        @foreach(var record in Model.Records)
        {
            @: { open: @record.Open, high: @record.High, low: @record.Low, close: @record.Close, time: "@record.Date.ToString("yyyy-MM-dd")" },
        }
        ]);


        indicatorData = {}

        indicatorData.volume = [
        @foreach(var record in Model.Records)
        {
            @: { value: @record.Volume, time: "@record.Date.ToString("yyyy-MM-dd")" },
        }
        ];

        indicatorData.volume50Day = [
        @foreach(var record in Model.Volume_MA_50_day)
        {
            @: { value: @record.Sma, time: "@record.Date.ToString("yyyy-MM-dd")" },
        }
        ];
        indicatorData.stock20Day = [
        @foreach(var record in Model.MA_20_day)
        {
            @: { value: @record.Sma, time: "@record.Date.ToString("yyyy-MM-dd")" },
        }
        ];
        indicatorData.stock10Week = [
        @foreach(var record in Model.MA_10)
        {
            @: { value: @record.Sma, time: "@record.Date.ToString("yyyy-MM-dd")" },
        }
        ];
        indicatorData.stock30Week = [
        @foreach(var record in Model.MA_30)
        {
            @: { value: @record.Sma, time: "@record.Date.ToString("yyyy-MM-dd")" },
        }
        ];
        indicatorData.stock40Week = [
        @foreach(var record in Model.MA_40)
        {
            @: { value: @record.Sma, time: "@record.Date.ToString("yyyy-MM-dd")" },
        }
        ];
        indicatorData.stock52High = [
        @foreach(var record in Model.Week_High_52)
        {
            @: { value: @record.Close, time: "@record.Date.ToString("yyyy-MM-dd")" },
        }
        ];
        indicatorData.stock52Low = [
        @foreach(var record in Model.Week_Low_52)
        {
            @: { value: @record.Close, time: "@record.Date.ToString("yyyy-MM-dd")" },
        }
        ];

        indicatorData.stockStrength = [
        @foreach(var record in Model.Records)
        {
            @if(record.RelativeStrength != null) {
                @: { value: @record.RelativeStrength, time: "@record.Date.ToString("yyyy-MM-dd")" },
            }
        }
        ];

        const markers = [
        @foreach(var record in Model.Stage2_Marks)
        {
            @: { time: { year: @record.Year, month: @record.Month, day: @record.Day }, position: 'aboveBar', color: '#e91e63', shape: 'circle', text: 'S2' },
        }
        ];
        toggleStage2()


        indicators = setUpIndicators(chart)

        for(const indicator in indicators) {
            indicators[indicator].setData(indicatorData[indicator])
        }


        function advanceData(retries=4) {
            if (retries == 0) return;
            currentDate = currentDate.add(1, 'days')
            $.ajax({
              url: '?handler=Price',
              method: 'GET',
              contentType: 'application/json; charset=utf-8',
              data: {
                ticker: "@Model.TickerInfo.Ticker",
                date: currentDate.format("YYYY-MM-DD")
              }
            }).done(function (data) {
                if(!data) {
                    advanceData(retries - 1);
                    return;
                }

                let { price, ma20day, volumeMA50day, ma10, ma30, ma40, week52High, week52Low, isStage2, spy, earnings } = data

                stockPrices.update({
                    open: price.open,
                    high: price.high,
                    low: price.low,
                    close: price.close,
                    time: moment(price.date).format("YYYY-MM-DD"),
                })

                spyPrices.update({
                    open: spy.open,
                    high: spy.high,
                    low: spy.low,
                    close: spy.close,
                    time: moment(spy.date).format("YYYY-MM-DD"),
                })

                indicators.volume.update({
                    value: price.volume,
                    time: moment(price.date).format("YYYY-MM-DD"),
                })

                indicators.volume50Day.update({
                    value: volumeMA50day.sma,
                    time: moment(volumeMA50day.date).format("YYYY-MM-DD"),
                })

                indicators.stock20Day.update({
                    value: ma20day.sma,
                    time: moment(ma20day.date).format("YYYY-MM-DD"),
                })

                indicators.stock10Week.update({
                    value: ma10.sma,
                    time: moment(ma10.date).format("YYYY-MM-DD"),
                })

                indicators.stock30Week.update({
                    value: ma30.sma,
                    time: moment(ma30.date).format("YYYY-MM-DD"),
                })

                indicators.stock40Week.update({
                    value: ma40.sma,
                    time: moment(ma40.date).format("YYYY-MM-DD"),
                })

                indicators.stock52High.update({
                    value: week52High.close,
                    time: moment(week52High.date).format("YYYY-MM-DD"),
                })

                indicators.stock52Low.update({
                    value: week52Low.close,
                    time: moment(week52High.date).format("YYYY-MM-DD"),
                })

                if(price.relativeStrength) {
                    indicators.stockStrength.update({
                        value: price.relativeStrength,
                        time: moment(price.date).format("YYYY-MM-DD"),
                    })
                }

                if(isStage2) {
                    let date = moment(price.date)
                    let object = { ...markers.at(-1), time: { year: date.year(), month: date.month() + 1, day: date.date() } }
                    markers.push(object)
                    stockPrices.setMarkers(markers)
                }

                if(earnings != null) {
                    earningsData.push({
                        time: moment(earnings.reportedDate).format("YYYY-MM-DD"),
                        fiscalDate: moment(earnings.fiscalDateEnding).format("YYYY-MM-DD"),
                        label: 'E',
                        eps: earnings.reportedEPS,
                        estimate: earnings.estimatedEPS,
                        surprise: earnings.surprisePercentage
                    });
                    drawTimeScaleMarkers(chart)
                }

                let latestDate = moment(slast(stockPrices).time)
                let latestPrice = slast(stockPrices).close
                Alpine.store("infoPanel").update(latestDate, latestPrice)
                Alpine.store("entryPoints").update(currentDate, slast(stockPrices).close, slast(stockPrices).low, slast(stockPrices).high, slast(stockPrices).open)
            })
        }

        function toggleIndicator(indicator) {
            indicators[indicator].applyOptions({ visible: !indicators[indicator].options().visible })
        }

        function toggleStage2() {
            if (stockPrices.markers().length > 0) {
                stockPrices.setMarkers([])
            } else {
                stockPrices.setMarkers(markers)
            }
        }

        function setPriceMode(mode) {
            intMode = scaleToChartInt(mode)
            chart.applyOptions({
                rightPriceScale: {
                    mode: intMode,
                },
            })
            chartSPY.applyOptions({
                rightPriceScale: {
                    mode: intMode,
                }
            })
        }

        function buyLatestDay() {
            let latestDate = Alpine.store("infoPanel").date
            let latestPrice = Alpine.store("infoPanel").price
            Alpine.store("entryPoints").addIfNew(latestDate, latestPrice)
        }

    </script>
}