@page
@model RealtimeModel
@{
    ViewData["Title"] = "Home page";
}

<div class="container-fluid p-4 h-100">
    <div class="row h-100">
        <div class="col-9 h-100">
            <div id="chart-spy" class="w-100 h-25"></div>
            <div id="chart" class="w-100 h-75"></div>
        </div>
        <div class="col-3 ps-4 d-flex flex-column gap-4">
            <h1 class="text-center display-4 my-0">@Model.TickerInfo.Name </h1>

            <div x-data>
                <p class="text-center">Latest date information</p>
                <div class="d-flex flex-row justify-content-between gap-4">
                    <table class="table table-sm align-bottom">
                        <tr>
                            <th>Date</th>
                            <td x-text="$store.infoPanel.date.format('ddd MMM DD, YYYY')"></td>
                        </tr>
                        <tr>
                            <th>Price</th>
                            <td x-text="Math.round($store.infoPanel.price * 100) / 100"></td>
                        </tr>
                    </table>
                    
                    <div class="d-flex flex-column gap-4">
                        <button :title="$store.infoPanel.nextDate.format('dddd MMM DD, YYYY')" data-bs-toggle="tooltip" data-bs-placement="top" class="btn btn-outline-dark d-flex flex-row gap-2 align-items-center" onclick="advanceData()">Next</button>
                        <button class="btn btn-outline-dark" onclick="buyLatestDay()">Buy</button>
                    </div>
                </div>
            </div>
            <div x-data>
                <p class="text-center">Your entry points</p>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Price</th>
                            <th>% Chg. to date</th>
                        </tr>
                    </thead>
                    <tbody> 
                        <template x-for="entry in $store.entryPoints.entries">
                            <tr>
                                <td><span x-text="entry.date.format('YYYY-MM-DD')"></span> (<span x-text="entry.holdingDays"></span>d)</td>
                                <td x-text="Math.round(entry.price * 100) / 100"></td>
                                <td><span x-text="Math.round(entry.pctChange * 100) / 100"></span>%</td>
                            </tr>
                        </template>
                    </tbody>
                </table>
            </div>
            <div class="btn-group">
                <button type="button" class="btn btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                  Toggle indicators
                </button>
                <ul class="dropdown-menu w-100 text-center">
                    <li><button class="dropdown-item btn btn-outline-primary" onclick="toggleMa10()">Toggle 10 MA</button></li>
                    <li><button class="dropdown-item btn btn-outline-primary" onclick="toggleMa30()">Toggle 30 MA</button></li>
                    <li><button class="dropdown-item btn btn-outline-primary" onclick="toggleMa40()">Toggle 40 MA</button></li>
                    <li><button class="dropdown-item btn btn-outline-primary" onclick="toggle52High()">Toggle 52 Week High</button></li>
                    <li><button class="dropdown-item btn btn-outline-primary" onclick="toggle52Low()">Toggle 52 Week Low</button></li>
                    <li><button class="dropdown-item btn btn-outline-primary" onclick="toggleStrength()">Toggle Strength</button></li>
                    <li><button class="dropdown-item btn btn-outline-primary" onclick="toggleStage2()">Toggle Stage 2</button></li>
                </ul>
            </div>
            <div class="btn-group">
                <button type="button" class="btn btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                  Change price scale
                </button>
                <ul class="dropdown-menu w-100 text-center">
                  <li><a class="dropdown-item" onclick="setPriceMode('linear')" href="#">Linear</a></li>
                  <li><a class="dropdown-item" onclick="setPriceMode('logarithmic')" href="#">Logarithmic</a></li>
                  <li><a class="dropdown-item" onclick="setPriceMode('percentage')" href="#">Percentage</a></li>
                </ul>
            </div>
            <div class="btn-group">
                <button type="button" class="btn btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                  Change time granularity
                </button>
                <ul class="dropdown-menu w-100 text-center">
                  <li><a class="dropdown-item" href="#">Daily</a></li>
                  <li><a class="dropdown-item" href="#">Weekly</a></li>
                </ul>
            </div>
        </div>
    </div>
</div>


@section Scripts
{
    <script>

        document.addEventListener('alpine:init', () => {
            Alpine.store('infoPanel', {
                date: moment(),
                nextDate: moment().clone().add(1, 'days'),
                price: 10,

                update(date, price) {
                    this.date = date
                    this.nextDate = date.clone().add(1, 'days')
                    this.price = price
                },
            })
            let date = moment(stockPrices.data().at(-1).time)
            let price = stockPrices.data().at(-1).close
            Alpine.store("infoPanel").update(date, price)

            Alpine.store('entryPoints', {
                entries: [],

                addIfNew(date, price) {
                    if(this.entries.find(e => e.date.format("YYYY-MM-DD") == date.format("YYYY-MM-DD")))
                        return;
                    this.entries.push({ date: date, price: price, holdingDays: 0, pctChange: 0 })
                },

                update(latestDate, latestPrice) {
                    for(let e of this.entries) {
                        e.pctChange = (latestPrice / e.price - 1) * 100
                        e.holdingDays = latestDate.diff(e.date, 'days')
                    }
                }
            })
        })

        @* Variables *@
        let lineSeries_10;
        let lineSeries_30;
        let lineSeries_40;
        let week_high_52;
        let week_low_52;
        let strength_line;

        let currentDate = moment("@Model.CutoffDate.ToString("yyyy-MM-dd")");

        let scaleToChartInt = function(s) {
            if(s == "linear") return 0;
            if(s == "logarithmic") return 1;
            if(s == "percentage") return 2
            return 0;
        }

        @* Logic *@
        const chartSPY = window.LightweightCharts.createChart(document.getElementById("chart-spy"), {
            autoSize: true,
            rightPriceScale: { mode: scaleToChartInt("logarithmic"), entireTextOnly: true, visible: true, minimumWidth: 80 },
            leftPriceScale: { visible: true, minimumWidth: 80 },
            timeScale: { visible: false }
        });
        const spyPrices = chartSPY.addCandlestickSeries();
        spyPrices.setData([
            @foreach(var record in Model.SPY)
            {
                @: { open: @record.Open, high: @record.High, low: @record.Low, close: @record.Close, time: "@record.Date.ToString("yyyy-MM-dd")" },
            }
        ]);

        const chart = window.LightweightCharts.createChart(document.getElementById("chart"), {
            autoSize: true,
            rightPriceScale: { mode: scaleToChartInt("logarithmic"), entireTextOnly: true, visible: true, minimumWidth: 80 },
            leftPriceScale: { visible: true, minimumWidth: 80 },
        });

        const stockPrices = chart.addBarSeries();
        stockPrices.setData([
        @foreach(var record in Model.Records)
        {
            @: { open: @record.Open, high: @record.High, low: @record.Low, close: @record.Close, time: "@record.Date.ToString("yyyy-MM-dd")" },
        }
        ]);

        stockPrices.priceScale().applyOptions({
            scaleMargins: {
                top: 0.1, // highest point of the series will be 10% away from the top
                bottom: 0.35, // lowest point will be 40% away from the bottom
            },
        });

        function getCrosshairDataPoint(series, param) {
            if (!param.time) {
                return null;
            }
            const dataPoint = param.seriesData.get(series);
            return dataPoint || null;
        }

        function syncCrosshair(chart, series, dataPoint) {
            if (dataPoint) {
                chart.setCrosshairPosition(dataPoint.value, dataPoint.time, series);
                return;
            }
            chart.clearCrosshairPosition();
        }

        chart.subscribeCrosshairMove(param => {
            const dataPoint = getCrosshairDataPoint(stockPrices, param);
            syncCrosshair(chartSPY, spyPrices, dataPoint);
        });

        chart.timeScale().subscribeVisibleLogicalRangeChange(timeRange => {
            chartSPY.timeScale().setVisibleLogicalRange(timeRange);
        });

        chartSPY.subscribeCrosshairMove(param => {
            const dataPoint = getCrosshairDataPoint(spyPrices, param);
            syncCrosshair(chart, stockPrices, dataPoint);
        });

        chartSPY.timeScale().subscribeVisibleLogicalRangeChange(timeRange => {
            chart.timeScale().setVisibleLogicalRange(timeRange);
        });

        const volumeSeries = chart.addHistogramSeries({
            priceFormat: {
                type: 'volume',
            },
            priceScaleId: '', // set as an overlay by setting a blank priceScaleId
        });
        volumeSeries.priceScale().applyOptions({
            // set the positioning of the volume series
            scaleMargins: {
                top: 0.7, // highest point of the series will be 70% away from the top
                bottom: 0,
            },
        });
        volumeSeries.setData([
        @foreach(var record in Model.Records)
        {
            @: { value: @record.Volume, time: "@record.Date.ToString("yyyy-MM-dd")" },
        }
        ]);

        let ma_10 = [
        @foreach(var record in Model.MA_10)
        {
            @: { value: @record.Sma, time: "@record.Date.ToString("yyyy-MM-dd")" },
        }
        ];
        const ma_30 = [
        @foreach(var record in Model.MA_30)
        {
            @: { value: @record.Sma, time: "@record.Date.ToString("yyyy-MM-dd")" },
        }
        ];
        const ma_40 = [
        @foreach(var record in Model.MA_40)
        {
            @: { value: @record.Sma, time: "@record.Date.ToString("yyyy-MM-dd")" },
        }
        ];
        const high_52 = [
        @foreach(var record in Model.Week_High_52)
        {
            @: { value: @record.Close, time: "@record.Date.ToString("yyyy-MM-dd")" },
        }
        ];
        const low_52 = [
        @foreach(var record in Model.Week_Low_52)
        {
            @: { value: @record.Close, time: "@record.Date.ToString("yyyy-MM-dd")" },
        }
        ];
        const strength = [
        @foreach(var record in Model.Records)
        {
            @if(record.RelativeStrength != null) {
                @: { value: @record.RelativeStrength, time: "@record.Date.ToString("yyyy-MM-dd")" },
            }
        }
        ];

        const markers = [
        @foreach(var record in Model.Stage2_Marks)
        {
            @: { time: { year: @record.Year, month: @record.Month, day: @record.Day }, position: 'aboveBar', color: '#e91e63', shape: 'circle', text: 'S2' },
        }
        ];
        toggleStage2()

        function advanceData(retries=4) {
            if (retries == 0) return;
            currentDate = currentDate.add(1, 'days')
            $.ajax({
              url: '?handler=Price',
              method: 'GET',
              contentType: 'application/json; charset=utf-8',
              data: {
                ticker: "@Model.TickerInfo.Ticker",
                date: currentDate.format("YYYY-MM-DD")
              }
            }).done(function (data) {
                if(!data) {
                    advanceData(retries - 1);
                    return;
                }

                let { price, ma10, ma30, ma40, week52High, week52Low, isStage2, spy } = data

                stockPrices.update({
                    open: price.open,
                    high: price.high,
                    low: price.low,
                    close: price.close,
                    time: moment(price.date).format("YYYY-MM-DD"),
                })

                volumeSeries.update({
                    value: price.volume,
                    time: moment(price.date).format("YYYY-MM-DD"),
                })

                lineSeries_10.update({
                    value: ma10.sma,
                    time: moment(ma10.date).format("YYYY-MM-DD"),
                })

                lineSeries_30.update({
                    value: ma30.sma,
                    time: moment(ma30.date).format("YYYY-MM-DD"),
                })

                lineSeries_40.update({
                    value: ma40.sma,
                    time: moment(ma40.date).format("YYYY-MM-DD"),
                })

                week_high_52.update({
                    value: week52High.close,
                    time: moment(week52High.date).format("YYYY-MM-DD"),
                })

                week_low_52.update({
                    value: week52Low.close,
                    time: moment(week52High.date).format("YYYY-MM-DD"),
                })

                if(price.relativeStrength) {
                    strength_line.update({
                        value: price.relativeStrength,
                        time: moment(price.date).format("YYYY-MM-DD"),
                    })
                }

                spyPrices.update({
                    open: spy.open,
                    high: spy.high,
                    low: spy.low,
                    close: spy.close,
                    time: moment(spy.date).format("YYYY-MM-DD"),
                })

                if(isStage2) {
                    let date = moment(price.date)
                    let object = { ...markers.at(-1), time: { year: date.year(), month: date.month() + 1, day: date.date() } }
                    markers.push(object)
                    stockPrices.setMarkers(markers)
                }

                let latestDate = moment(stockPrices.data().at(-1).time)
                let latestPrice = stockPrices.data().at(-1).close
                Alpine.store("infoPanel").update(latestDate, latestPrice)
                Alpine.store("entryPoints").update(currentDate, stockPrices.data().at(-1).close)
            })
        }

        lineSeries_10 = chart.addLineSeries({ color: "blue", lineWidth: 2, visible: false });
        lineSeries_10.setData(ma_10)
        lineSeries_30 = chart.addLineSeries({ color: "green", lineWidth: 2, visible: false });
        lineSeries_30.setData(ma_30)
        lineSeries_40 = chart.addLineSeries({ color: "red", lineWidth: 2, visible: false });
        lineSeries_40.setData(ma_40)
        week_high_52 = chart.addLineSeries({ color: "lightgreen", lineWidth: 3, visible: false });
        week_high_52.setData(high_52)
        week_low_52 = chart.addLineSeries({ color: "#FFCCCB", lineWidth: 3, visible: false });
        week_low_52.setData(low_52)
        strength_line = chart.addLineSeries({ color: "#FFCCCB", lineWidth: 3, priceScaleId: 'left', visible: false });
        strength_line.setData(strength)

        function toggleMa10() {
            lineSeries_10.applyOptions({ visible: !lineSeries_10.options().visible })
        }

        function toggleMa30() {
            lineSeries_30.applyOptions({ visible: !lineSeries_30.options().visible })
        }

        function toggleMa40() {
            lineSeries_40.applyOptions({ visible: !lineSeries_40.options().visible })
        }

        function toggle52High() {
            week_high_52.applyOptions({ visible: !week_high_52.options().visible })
        }

        function toggle52Low() {
            week_low_52.applyOptions({ visible: !week_low_52.options().visible })
        }

        function toggleStrength() {
            strength_line.applyOptions({ visible: !strength_line.options().visible })
        }

        function toggleStage2() {
            if (stockPrices.markers().length > 0) {
                stockPrices.setMarkers([])
            } else {
                stockPrices.setMarkers(markers)
            }
        }

        function setPriceMode(mode) {
            intMode = scaleToChartInt(mode)
            chart.applyOptions({
                rightPriceScale: {
                    mode: intMode,
                },
            })
            chartSPY.applyOptions({
                rightPriceScale: {
                    mode: intMode,
                }
            })
        }

        function scrollToTime(time, timeScale){
            const currentPosition = timeScale.scrollPosition();
            const currentVisibleLogicalRange = timeScale.getVisibleLogicalRange();

            const coordinate = timeScale.timeToCoordinate(time);
            const logicalIndex = timeScale.coordinateToLogical(coordinate);

            const targetPosition = currentPosition - currentVisibleLogicalRange.to + logicalIndex;
            timeScale.scrollToPosition(targetPosition, false);
        }


        @* function myClickHandler(param) {
            if (!param.point) {
                return;
            }

            const data = param.seriesData.get(stockPrices);
            const price = data.value !== undefined ? data.value : data.close;
        }

        chart.subscribeClick(myClickHandler); *@

        function buyLatestDay() {
            let latestDate = Alpine.store("infoPanel").date
            let latestPrice = Alpine.store("infoPanel").price
            Alpine.store("entryPoints").addIfNew(latestDate, latestPrice)
        }

    </script>
}